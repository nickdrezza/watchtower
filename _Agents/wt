#!/usr/bin/env python3
"""wt: the one tool for this vault. Python 3.9+ standard library only.

    wt search <terms...>     find pages about the terms; print pointers, never file bodies
    wt search --hook         Claude Code UserPromptSubmit hook (reads the prompt as JSON on stdin)
    wt search --test         run _Agents/search-fixtures.json
    wt doctor [--fix] [--json] [--errors-only]
                             integrity checks; --fix applies mechanical fixes only
    wt install [--copy] [--dry-run] [--force]
                             instruction stubs, one link per skill, search hook, pre-commit hook
    wt index [--check]       write the cached snapshot under each okf-view block

Exit codes: 0 = clean, 1 = findings (or stale snapshots with --check), 2 = could not run.
"""
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.parse
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WT = ROOT / "_Agents" / "wt"
CONFIG = ROOT / ".isomorphic.json"
FIXTURES = ROOT / "_Agents" / "search-fixtures.json"
TAG_REGISTRY = ROOT / "Maps" / "Tag Registry.md"
SKILL_INDEX = ROOT / "_Agents" / "README.md"
GLOBAL_TEXT = ROOT / "_Agents" / "global-instructions.md"
SETTINGS = ROOT / "_Agents" / "wt.json"  # optional per-vault overrides: {"triggers": [...], "users": [...]}

# Agent folders that are not pages (system) but are searched.
AGENT_SEARCH_ROOTS = ("_Agents/memory/", "_Agents/skills/", "_Agents/docs/")
# Lower rank = shown first.
RANK = (("_Agents/memory/", 0), ("_Agents/skills/", 1), ("_Agents/docs/", 3))
MAX_HITS = 5

# Words in a prompt that start a hook search. Whole words only. Keep out words that occur in almost
# every prompt (context, agents, instructions, token): they make the hook fire on everything.
TRIGGERS = (
    "vault", "warehouse", "crm", "github", "tracker", "tickets", "connector", "credentials",
    "secrets", "deployment", "worktree", "meeting", "interview", "diary", "career",
)

# Account names whose home paths must not appear in skills. Set yours in _Agents/wt.json.
USERS = r"alice|bob"

try:
    _settings = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
except ValueError:
    _settings = {}
TRIGGERS = tuple(_settings.get("triggers", TRIGGERS))
USERS = "|".join(map(re.escape, _settings["users"])) if _settings.get("users") else USERS

DESCRIPTION_MIN, DESCRIPTION_MAX = 100, 300
MEMORY_MAX_LINES = 200
STALE_DAYS = 180
TITLE_EXEMPT = {"index", "SKILL", "README", "AGENTS", "CLAUDE", "GEMINI", "reference"}
FRONTMATTER_EXEMPT = ("_Agents/", ".github/", ".claude/", ".agents/")
FRONTMATTER_EXEMPT_FILES = {"README.md", "AGENTS.md", "CLAUDE.md", "GEMINI.md", "TODO.md"}
# Placeholders in prose about links, not real links.
GENERIC_LINKS = {"link", "links", "wiki-links", "name", "their-name", "concept", "…", "...",
                 "old name", "Note Name", "_Templates/Weekly Work Log"}
SECRET_PATTERNS = (
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----\n[A-Za-z0-9+/=]{40}",
    r"\bAKIA[0-9A-Z]{16}\b", r"\bgh[pousr]_[A-Za-z0-9]{36}\b", r"\bsk-[A-Za-z0-9_-]{32,}\b",
    r"\bxox[abpr]-[A-Za-z0-9-]{20,}\b", r"\bAIza[0-9A-Za-z_-]{35}\b",
)

SNAP_BEGIN = "<!-- okf-view:snapshot (generated: do not edit, recomputed on save) -->"
SNAP_END = "<!-- /okf-view:snapshot -->"
STUB_MARK = "<!-- generated by _Agents/wt install -->"
OLD_STUB_MARKS = ("<!-- generated by _Agents/scripts/install-instructions.sh -->",
                  "<!-- generated by .agents/scripts/install-instructions.sh -->")
PRECOMMIT_MARK = "# generated by _Agents/wt install"


# ---------- files and config ----------

def git(*args):
    return subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True, text=True)


def repo_files():
    """Tracked files plus new files git does not ignore."""
    out = git("ls-files", "-z", "--cached", "--others", "--exclude-standard").stdout
    return sorted({p for p in out.split("\0") if p and (ROOT / p).exists()})


def read(rel):
    try:
        return (ROOT / rel).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return ""


def path_roles():
    try:
        paths = json.loads(CONFIG.read_text()).get("paths", {})
    except (OSError, ValueError):
        paths = {}
    return paths or {".": "content"}


def role(rel, roles):
    """Longest matching prefix wins; unmatched paths are system (Isomorphic's rule)."""
    best, best_len = "system", -1
    for key, r in roles.items():
        k = "" if key in (".", "./") else key
        if (rel == k or rel.startswith(k.rstrip("/") + "/") or k == "") and len(k) > best_len:
            best, best_len = r, len(k)
    return best


def frontmatter(text):
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    return text[4:end] if end != -1 else None


def fm_value(fm, key):
    """A scalar or a list, parsed line-wise so one key never swallows the next."""
    lines = (fm or "").split("\n")
    for i, line in enumerate(lines):
        if not line.startswith(key + ":"):
            continue
        rest = line[len(key) + 1:].strip()
        if rest.startswith("["):
            return [v.strip().strip("\"'") for v in rest.strip("[]").split(",") if v.strip()]
        if rest and rest not in (">", "|", ">-", "|-"):
            return rest.strip("\"'")
        vals, block = [], []
        for nxt in lines[i + 1:]:
            if nxt.strip().startswith("- "):
                vals.append(nxt.strip()[2:].strip().strip("\"'"))
            elif nxt.startswith((" ", "\t")) and nxt.strip():
                block.append(nxt.strip())
            elif nxt.strip() == "":
                continue
            else:
                break
        return vals if vals else " ".join(block)
    return None


def title_of(rel):
    fm = frontmatter(read(rel))
    t = fm_value(fm, "title") if fm else None
    if isinstance(t, str) and t:
        return t
    p = Path(rel)
    return p.parent.name if p.stem == "index" and p.parent.name else p.stem


def strip_code(text):
    """Blank out fenced and inline code so examples are not read as links."""
    text = re.sub(r"(?ms)^(```|~~~).*?^\1", lambda m: "\n" * m.group(0).count("\n"), text)
    return re.sub(r"`[^`\n]*`", "", text)


def slug(heading):
    """GitHub's heading anchor."""
    h = re.sub(r"[^\w\- ]", "", heading.strip().lower())
    return h.replace(" ", "-")


def anchors(rel):
    out, seen = set(), defaultdict(int)
    for m in re.finditer(r"(?m)^#{1,6}\s+(.+?)\s*#*\s*$", strip_code(read(rel))):
        s = slug(m.group(1))
        out.add(s if not seen[s] else f"{s}-{seen[s]}")
        seen[s] += 1
        out.add(m.group(1).strip().lower())  # Obsidian [[Note#Heading]] form
    return out


# ---------- search ----------

def search_roots(files, roles):
    return [f for f in files if f.endswith(".md") and
            (f.startswith(AGENT_SEARCH_ROOTS) or role(f, roles) == "content")]


def rank_of(rel):
    for prefix, r in RANK:
        if rel.startswith(prefix):
            return r
    return 2


def search(terms, limit=MAX_HITS):
    files = search_roots(repo_files(), path_roles())
    pats = {t: re.compile(r"(?<![\w-])" + re.escape(t) + r"(?![\w-])", re.I) for t in terms}
    hits = []
    for f in files:
        found = [t for t, p in pats.items() if p.search(f) or p.search(read(f))]
        if found:
            in_path = sum(1 for t in found if pats[t].search(f))  # a page named for the topic first
            hits.append((-(len(found) + in_path), rank_of(f), f, found))
    hits.sort()
    return [(f, found) for _, _, f, found in hits[:limit]], len(hits)


def report(terms):
    hits, total = search(terms)
    if not hits:
        return ""
    lines = [f"Vault pages for: {', '.join(terms)}. Open only the relevant ones. Root: {ROOT}", ""]
    lines += [f"  {f}  ({', '.join(found)})" for f, found in hits]
    if total > len(hits):
        lines.append(f"  … {total - len(hits)} more: run `_Agents/wt search` with narrower terms.")
    return "\n".join(lines)


def prompt_terms(prompt):
    return [t for t in TRIGGERS if re.search(r"(?<![\w-])" + re.escape(t) + r"(?![\w-])", prompt, re.I)]


def cmd_search(args):
    if "--hook" in args:
        try:
            prompt = json.load(sys.stdin).get("prompt", "")
        except (ValueError, AttributeError):
            return 0
        text = report(prompt_terms(prompt)) if prompt else ""
        if text:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                                     "additionalContext": text},
                              "suppressOutput": True}))
        return 0
    if "--test" in args:
        return search_test()
    terms = [a for a in args if not a.startswith("--")]
    if not terms:
        print(__doc__.strip().split("\n\n")[1])
        return 2
    print(report(terms) or f"No vault pages for: {' '.join(terms)}")
    return 0


def search_test():
    try:
        cases = json.loads(FIXTURES.read_text())
    except (OSError, ValueError) as e:
        print(f"cannot read {FIXTURES.relative_to(ROOT)}: {e}", file=sys.stderr)
        return 2
    failed = 0
    for c in cases:
        terms = prompt_terms(c["prompt"])
        got = [f for f, _ in search(terms)[0]] if terms else []
        want = c.get("expect", [])
        ok = (not got) if not want else all(w in got for w in want)
        if not ok:
            failed += 1
            print(f"FAIL  {c['prompt']!r}\n      want {want or 'nothing'}\n      got  {got or 'nothing'}")
    print(f"search fixtures: {len(cases) - failed}/{len(cases)} pass")
    return 1 if failed else 0


# ---------- doctor ----------

class Findings:
    def __init__(self):
        self.items = defaultdict(list)  # check -> [(severity, text)]

    def add(self, check, text, severity="error"):
        self.items[check].append((severity, text))

    def errors(self):
        return sum(1 for v in self.items.values() for s, _ in v if s == "error")


def resolve_wikilink(name, stems, paths_noext):
    if name in stems or name in GENERIC_LINKS or name.endswith(".base"):
        return True
    return name.strip("/") in paths_noext


def check_links(md, files, f):
    stems = defaultdict(list)
    for p in files:
        if p.endswith((".md", ".base", ".canvas")):
            stems[Path(p).stem].append(p)
            if Path(p).stem == "index":
                stems[Path(p).parent.name].append(p)
    paths_noext = {os.path.splitext(p)[0] for p in files}
    anchor_cache = {}

    def has_anchor(target, a):
        if target not in anchor_cache:
            anchor_cache[target] = anchors(target)
        return a.lower() in anchor_cache[target] or slug(a) in anchor_cache[target]

    for p in md:
        text = strip_code(read(p))
        for m in re.finditer(r"\[[^\]]*\]\(<?([^)>]+)>?\)", text):
            raw = m.group(1).strip().split(" ")[0] if " \"" in m.group(1) else m.group(1).strip()
            if not raw or raw.startswith(("http://", "https://", "mailto:", "obsidian://")) or "…" in raw:
                continue
            target_s, _, anchor = raw.partition("#")
            target = p if not target_s else os.path.normpath(
                os.path.join(os.path.dirname(p), urllib.parse.unquote(target_s)))
            if not (ROOT / target).exists():
                f.add("broken-link", f"{p} -> {raw}")
            elif anchor and target.endswith(".md") and not has_anchor(target, urllib.parse.unquote(anchor)):
                f.add("broken-anchor", f"{p} -> {raw}")
        for m in re.finditer(r"!?\[\[([^\]|]+)(?:\|[^\]]*)?\]\]", text):
            name, _, anchor = m.group(1).partition("#")
            name = name.strip()
            if not name:
                continue
            if not resolve_wikilink(name, stems, paths_noext):
                f.add("broken-link", f"{p} -> [[{m.group(1)}]]")
            elif anchor and not anchor.startswith("^"):
                target = stems.get(name, [name + ".md"])[0]
                if target.endswith(".md") and (ROOT / target).exists() and not has_anchor(target, anchor):
                    f.add("broken-anchor", f"{p} -> [[{m.group(1)}]]")


def check_pages(md, roles, f):
    titles = defaultdict(list)
    allowed = set(re.findall(r"`([A-Za-z][\w/-]*)`", read(str(TAG_REGISTRY.relative_to(ROOT)))))
    today = datetime.date.today()
    for p in md:
        text = read(p)
        fm = frontmatter(text)
        name = Path(p).name
        if not text.strip():
            f.add("empty-file", p, "warning")
        if Path(p).stem.startswith("Untitled"):
            f.add("untitled-file", p, "warning")
        if role(p, roles) == "content" and Path(p).stem not in TITLE_EXEMPT:
            titles[title_of(p).lower()].append(p)
        if fm is None and not p.startswith(FRONTMATTER_EXEMPT) and name not in FRONTMATTER_EXEMPT_FILES:
            f.add("missing-frontmatter", p)
        if fm and allowed and not p.startswith("_Agents/"):
            tags = fm_value(fm, "tags") or []
            for t in ([tags] if isinstance(tags, str) else tags):
                if t and t not in allowed:
                    f.add("unregistered-tag", f"{p} -> {t}")
        if p.startswith("_Agents/memory/"):
            n = text.count("\n")
            if n > MEMORY_MAX_LINES:
                f.add("oversized-file", f"{p} ({n} lines > {MEMORY_MAX_LINES})", "warning")
            upd = fm_value(fm, "updated") if fm else None
            try:
                age = (today - datetime.date.fromisoformat(str(upd))).days if upd else None
            except ValueError:
                age = None
            if age is not None and age > STALE_DAYS:
                f.add("stale-memory", f"{p} (updated {upd}, {age} days ago)", "warning")
        m = re.match(r"Spaces/([^/]+)/", p)
        if m:
            for link in re.finditer(r"\]\(([^)#]+)", strip_code(text)):
                tgt = os.path.normpath(os.path.join(os.path.dirname(p), urllib.parse.unquote(link.group(1))))
                other = re.match(r"Spaces/([^/]+)/", tgt)
                if other and other.group(1) != m.group(1):
                    f.add("cross-space-link", f"{p} -> {link.group(1)}", "warning")
    for t, ps in titles.items():
        if len(ps) > 1:
            f.add("duplicate-title", f"'{t}': " + ", ".join(ps), "warning")


def skill_dirs():
    out = []
    for base in [ROOT / "_Agents" / "skills", *sorted((ROOT / "Spaces").glob("*/skills"))]:
        if base.is_dir():
            out += sorted(d for d in base.iterdir() if (d / "SKILL.md").is_file())
    return out


def check_skills(f):
    index = read(str(SKILL_INDEX.relative_to(ROOT)))
    for d in skill_dirs():
        rel = d.relative_to(ROOT).as_posix()
        fm = frontmatter((d / "SKILL.md").read_text(encoding="utf-8")) or ""
        name = fm_value(fm, "name")
        if not name:
            f.add("skill-no-name", rel)
        elif name != d.name:
            f.add("skill-name-mismatch", f"{rel} declares name: {name}")
        desc = fm_value(fm, "description") or ""
        n = len(" ".join(str(desc).split()))
        if n < DESCRIPTION_MIN:
            f.add("skill-description-short", f"{d.name} ({n} chars < {DESCRIPTION_MIN})", "warning")
        elif n > DESCRIPTION_MAX:
            f.add("skill-description-long", f"{d.name} ({n} chars > {DESCRIPTION_MAX})", "warning")
        if index and not re.search(rf"`{re.escape(d.name)}`|\({re.escape(d.name)}/\)|skills/{re.escape(d.name)}/", index):
            f.add("skill-not-indexed", f"{SKILL_INDEX.relative_to(ROOT)} missing '{d.name}'")


def check_files(files, f):
    path_pat = re.compile(rf"/mnt/c/|[A-Z]:\\Users\\|/(?:Users|home)/(?:{USERS})\b|~/\.claude/skills")
    secret_pat = re.compile("|".join(SECRET_PATTERNS))
    for p in files:
        if p.endswith((".png", ".jpg", ".pdf", ".zip")):
            continue
        text = read(p)
        if p.startswith("_Agents/skills/") or re.match(r"Spaces/[^/]+/skills/", p):
            for i, line in enumerate(text.splitlines(), 1):
                if path_pat.search(line):
                    f.add("hardcoded-machine-path", f"{p}:{i}")
        for m in secret_pat.finditer(text):
            f.add("secret-pattern", f"{p}:{text.count(chr(10), 0, m.start()) + 1}")
    for stray in ("_Agents/skills/synced", "_Agents/skills/.trash", ".claude/skills"):
        if (ROOT / stray).exists():
            f.add("stray-folder", f"{stray} (harness-managed copy; `wt install` removes .claude/skills)",
                  "warning")


def renames():
    base = git("merge-base", "HEAD", "origin/main").stdout.strip() or "HEAD"
    out = git("diff", "-M", "--name-status", "-z", base).stdout.split("\0")
    pairs, i = {}, 0
    while i < len(out) - 1:
        status = out[i]
        if status.startswith("R"):
            pairs[out[i + 1]] = out[i + 2]
            i += 3
        else:
            i += 2
    return pairs


def rel_href(from_file, to_file, encode):
    href = os.path.relpath(to_file, os.path.dirname(from_file) or ".")
    return urllib.parse.quote(href) if encode else href


def fix_links(md, files):
    """Repoint links after moves and renames. Only rewrites a link that is broken today."""
    moved = renames()
    by_name = defaultdict(list)
    for p in files:
        by_name[Path(p).name].append(p)
    stem_moves = {Path(o).stem: Path(n).stem for o, n in moved.items()
                  if o.endswith(".md") and Path(o).stem != Path(n).stem}
    changed = []
    for p in md:
        text = read(p)
        new = text

        def md_link(m):
            label, raw = m.group(1), m.group(2)
            target_s, hash_, anchor = raw.partition("#")
            if not target_s or target_s.startswith(("http://", "https://", "mailto:")):
                return m.group(0)
            old = os.path.normpath(os.path.join(os.path.dirname(p), urllib.parse.unquote(target_s)))
            if (ROOT / old).exists():
                return m.group(0)
            dest = moved.get(old)
            if not dest:
                cands = by_name.get(Path(old).name, [])
                dest = cands[0] if len(cands) == 1 else None
            if not dest:
                return m.group(0)
            encode = "%" in target_s
            return f"[{label}]({rel_href(p, dest, encode)}{hash_}{anchor})"

        new = re.sub(r"\[([^\]]*)\]\(([^)<>\s]+)\)", md_link, new)

        def wiki(m):
            name, rest = m.group(1), m.group(2)
            if name in stem_moves and not any(Path(f).stem == name for f in files):
                return f"[[{stem_moves[name]}{rest}]]"
            return m.group(0)

        new = re.sub(r"\[\[([^\]|#]+)((?:#[^\]|]*)?(?:\|[^\]]*)?)\]\]", wiki, new)
        if new != text:
            (ROOT / p).write_text(new, encoding="utf-8")
            changed.append(p)
    return changed


def cmd_doctor(args):
    files = repo_files()
    md = [p for p in files if p.endswith(".md")]
    roles = path_roles()
    if "--fix" in args:
        for p in fix_links(md, files):
            print(f"fixed links  {p}")
        index_views(check=False, quiet=True)
    f = Findings()
    check_links(md, files, f)
    check_pages(md, roles, f)
    check_skills(f)
    check_files(files, f)
    for p in index_views(check=True, quiet=True):
        f.add("stale-snapshot", f"{p} (run `_Agents/wt index`)")
    errors_only = "--errors-only" in args
    if "--json" in args:
        print(json.dumps({k: [{"severity": s, "item": t} for s, t in v] for k, v in f.items.items()},
                         indent=2, sort_keys=True))
    else:
        shown = {k: [(s, t) for s, t in v if s == "error" or not errors_only] for k, v in f.items.items()}
        shown = {k: v for k, v in shown.items() if v}
        print(f"wt doctor: {len(md)} markdown files, {len(files)} files")
        for k in sorted(shown, key=lambda k: (shown[k][0][0] != "error", k)):
            v = shown[k]
            print(f"\n{v[0][0]}  {k}  ({len(v)})")
            for _, t in v[:25]:
                print(f"    {t}")
            if len(v) > 25:
                print(f"    … and {len(v) - 25} more")
        warnings = sum(len(v) for v in f.items.values()) - f.errors()
        print(f"\n{f.errors()} error(s), {warnings} warning(s)")
    return 1 if f.errors() else 0


# ---------- index (okf-view snapshots) ----------

def parse_view(yaml):
    spec = {}
    for line in yaml.splitlines():
        k, _, v = line.partition(":")
        if v:
            spec[k.strip()] = v.strip().strip("\"'")
    return spec


def render_view(spec, page, content_pages):
    kind, as_ = spec.get("kind", ""), spec.get("as", "list")
    if kind not in ("pages", "folders"):
        return None  # backlinks views need a link index: Isomorphic computes them
    under = spec.get("under", "").strip("/")
    rows = []
    if kind == "pages":
        rows = [p for p in content_pages if p != page and (not under or p.startswith(under + "/"))]
    else:
        base = ROOT / under
        for d in sorted(x for x in base.iterdir() if x.is_dir() and not x.name.startswith(".")) if base.is_dir() else []:
            note = (d / "index.md").relative_to(ROOT).as_posix()
            rows.append(note if (d / "index.md").exists() else d.relative_to(ROOT).as_posix())
    rows.sort(key=lambda r: title_of(r).lower())
    if as_ == "count":
        return f"**{len(rows)}**" + (f" {spec['label']}" if spec.get("label") else "")
    if not rows:
        return "*No matching pages.*"

    def link(r):
        t = title_of(r) if r.endswith(".md") else Path(r).name
        if not r.endswith(".md"):
            return t
        href = os.path.relpath(r, os.path.dirname(page) or ".")
        return f"[{t}](<{href}>)" if re.search(r"[ ()]", href) else f"[{t}]({href})"

    def field(r, key):
        v = fm_value(frontmatter(read(r)), key) if r.endswith(".md") else None
        return ", ".join(v) if isinstance(v, list) else (v or "")

    if as_ == "table":
        cols = [c.strip() for c in spec.get("columns", "title").strip("[]").split(",") if c.strip()]
        out = ["| " + " | ".join("Title" if c == "title" else c for c in cols) + " |",
               "| " + " | ".join("---" for _ in cols) + " |"]
        for r in rows:
            out.append("| " + " | ".join(link(r) if c == "title" else field(r, c).replace("|", "\\|")
                                         for c in cols) + " |")
        return "\n".join(out)
    d = spec.get("describe")
    return "\n".join(f"- {link(r)}" + (f" - {field(r, d)}" if d and field(r, d) else "") for r in rows)


def index_views(check=False, quiet=False):
    """Write (or, with check, list stale) okf-view snapshots. Returns the pages that changed."""
    roles = path_roles()
    files = repo_files()
    content = [p for p in files if p.endswith(".md") and role(p, roles) == "content"]
    fence = re.compile(r"(?ms)^```okf-view\n(.*?)^```\n(?:\n*" + re.escape(SNAP_BEGIN) + r"\n.*?"
                       + re.escape(SNAP_END) + r"\n)?")
    stale = []
    for p in [x for x in files if x.endswith(".md")]:
        text = read(p)
        if "```okf-view" not in text:
            continue

        def sub(m):
            body = render_view(parse_view(m.group(1)), p, content)
            if body is None:
                return m.group(0)
            return f"```okf-view\n{m.group(1)}```\n\n{SNAP_BEGIN}\n{body}\n{SNAP_END}\n"

        new = fence.sub(sub, text)
        if new != text:
            stale.append(p)
            if not check:
                (ROOT / p).write_text(new, encoding="utf-8")
                if not quiet:
                    print(f"indexed  {p}")
    return stale


def cmd_index(args):
    stale = index_views(check="--check" in args)
    if "--check" in args:
        for p in stale:
            print(f"stale snapshot  {p}")
        return 1 if stale else 0
    if not stale:
        print("snapshots up to date")
    return 0


