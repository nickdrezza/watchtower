def stub():
    """The global instruction file: a marker plus _Agents/global-instructions.md."""
    text = GLOBAL_TEXT.read_text(encoding="utf-8") if GLOBAL_TEXT.exists() else \
        "**Read `{AGENTS}`.** It is the single source of instructions for every AI agent.\n"
    text = text.replace("{AGENTS}", str(ROOT / "AGENTS.md")).replace("{WT}", str(WT))
    return f"# Global agent instructions\n\n{STUB_MARK}\n\n{text}"


def is_our_hook(command):
    return "wt-search.sh --hook" in command or ("_Agents/wt" in command and "search --hook" in command)


class Installer:
    def __init__(self, dry, copy, force):
        self.dry, self.copy, self.force = dry, copy, force

    def do(self, msg, fn=None):
        print(("would " if self.dry else "") + msg)
        if fn and not self.dry:
            fn()

    def instructions(self):
        home = Path.home()
        for d, name in ((".claude", "CLAUDE.md"), (".codex", "AGENTS.md"), (".gemini", "GEMINI.md"),
                        (".cursor", "AGENTS.md")):
            target = home / d / name
            if not (home / d).is_dir():
                continue
            old = target.read_text(encoding="utf-8") if target.exists() else ""
            ours = not old.strip() or STUB_MARK in old or any(m in old for m in OLD_STUB_MARKS)
            if not ours and not self.force:
                print(f"skip     {target} (hand-written; --force replaces it)")
                continue
            if old != stub():
                self.do(f"write    {target}", lambda t=target: t.write_text(stub(), encoding="utf-8"))

    def skills(self):
        home = Path.home()
        skills = skill_dirs()
        names = {d.name for d in skills}
        for target in (home / ".agents" / "skills", home / ".claude" / "skills"):
            fresh = target.is_symlink()  # an old whole-folder link: the harness writes into the vault
            if fresh:
                self.do(f"unlink   {target} -> {os.readlink(target)} (replace with one link per skill)",
                        target.unlink)
            if fresh or not target.exists():
                self.do(f"mkdir    {target}", lambda t=target: t.mkdir(parents=True))
            existing = [] if fresh or not target.is_dir() else list(target.iterdir())
            for e in existing:  # remove our links to skills that no longer exist
                if e.is_symlink() and str(ROOT) in os.readlink(e) and not Path(os.readlink(e)).exists():
                    self.do(f"remove   {e} (stale)", e.unlink)
            for d in skills:
                dest = target / d.name
                if not fresh and dest.is_symlink() and Path(os.readlink(dest)) == d:
                    continue
                if not fresh and dest.exists() and not dest.is_symlink() and not self.copy:
                    print(f"skip     {dest} (a different skill with this name exists)")
                    continue
                if self.copy:
                    def cp(dest=dest, d=d):
                        if dest.is_symlink() or dest.is_file():
                            dest.unlink()
                        elif dest.exists():
                            shutil.rmtree(dest)
                        shutil.copytree(d, dest)
                    self.do(f"copy     {d.relative_to(ROOT)} -> {dest}", cp)
                else:
                    def ln(dest=dest, d=d):
                        if dest.is_symlink():
                            dest.unlink()
                        dest.symlink_to(d, target_is_directory=True)
                    self.do(f"link     {dest} -> {d.relative_to(ROOT)}", ln)
        mirror = ROOT / ".claude" / "skills"
        if mirror.is_dir() and not mirror.is_symlink() and {p.name for p in mirror.iterdir()} <= names:
            self.do(f"remove   {mirror} (old in-repo copy; the global links replace it)",
                    lambda: shutil.rmtree(mirror))

    def hook(self):
        settings = Path.home() / ".claude" / "settings.json"
        if not settings.parent.is_dir():
            return
        try:
            data = json.loads(settings.read_text()) if settings.exists() else {}
        except ValueError:
            print(f"skip     {settings} (not valid JSON; fix it, then re-run)")
            return
        command = f'"{WT}" search --hook'
        groups = data.setdefault("hooks", {}).setdefault("UserPromptSubmit", [])
        kept = []  # every other hook unchanged; ours removed, then added once at the end
        for g in groups:
            hooks = [h for h in g.get("hooks", []) if not is_our_hook(h.get("command", ""))]
            if hooks:
                kept.append({**g, "hooks": hooks})
        kept.append({"hooks": [{"type": "command", "command": command}]})
        if kept != groups:
            data["hooks"]["UserPromptSubmit"] = kept
            self.do(f"hook     {settings} (UserPromptSubmit -> wt search --hook)",
                    lambda: settings.write_text(json.dumps(data, indent=2) + "\n"))

    def precommit(self):
        hooks_dir = Path(git("rev-parse", "--git-path", "hooks").stdout.strip() or ".git/hooks")
        hooks_dir = hooks_dir if hooks_dir.is_absolute() else ROOT / hooks_dir
        target = hooks_dir / "pre-commit"
        body = f'#!/bin/sh\n{PRECOMMIT_MARK}\nexec python3 "{WT}" doctor --errors-only\n'
        if target.exists() and PRECOMMIT_MARK not in target.read_text():
            print(f"skip     {target} (a different pre-commit hook exists)")
            return
        if not target.exists() or target.read_text() != body:
            def write():
                hooks_dir.mkdir(parents=True, exist_ok=True)
                target.write_text(body)
                target.chmod(0o755)
            self.do(f"hook     {target} (wt doctor --errors-only)", write)


def cmd_install(args):
    i = Installer(dry="--dry-run" in args, copy="--copy" in args, force="--force" in args)
    i.instructions()
    i.skills()
    i.hook()
    i.precommit()
    print("done")
    return 0


def main(argv):
    cmds = {"search": cmd_search, "doctor": cmd_doctor, "install": cmd_install, "index": cmd_index}
    if not argv or argv[0] not in cmds:
        print(__doc__.strip())
        return 0 if argv and argv[0] in ("-h", "--help") else 2
    if not (ROOT / ".git").exists():
        print(f"error: {ROOT} is not a git repository", file=sys.stderr)
        return 2
    return cmds[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
