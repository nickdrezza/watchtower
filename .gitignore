# Local Obsidian state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/graph.json
_Vault Maintenance/Nested Obsidian Config Snapshot/

# Community plugin bundles are reinstallable and noisy in git.
.obsidian/plugins/
.obsidian/snippets/

# Code/styling don't belong in a text-first notes repo.
# (_Agents/ is exempt: skills may ship small runnable helpers under _Agents/skills/*/scripts/.)
*.js
*.css
!_Agents/**/*.js

# Old in-repo copy of _Agents/skills. `_Agents/wt install` links each skill globally instead.
.claude/skills/

# Keep this repo text-first.
Images/
Attachments/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.pdf

# Secrets and local environment files
*.pem
*.key
*.p8
*.p12
*.env
.env*

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
